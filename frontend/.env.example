# Local dev (`npm run dev`): leave VITE_API_URL unset — the app calls /api/v1 on port 3000 and Vite proxies to the API (see vite.config.ts).
# Production build / static hosting: set the public API origin, e.g. VITE_API_URL=https://api.example.com
# VITE_API_URL=
# VITE_WS_URL=ws://localhost:8000
VITE_APP_NAME=Quantyx AI
